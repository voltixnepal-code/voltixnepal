rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS & ADMIN SECURITY
    // ==========================================

    // Returns true if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns true if the user's email is an authorized VoltixNepal Admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'voltixnepal@gmail.com' ||
        request.auth.token.email.lower() == 'bishaldev949@gmail.com' ||
        request.auth.token.email.lower() == 'info@voltixnepal.com' ||
        request.auth.token.admin == true ||
        request.auth.token.role == 'ADMIN'
      );
    }

    // Returns true if user is accessing their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // 1. SERVICE REQUESTS, ORDERS & BOOKINGS
    // ==========================================
    match /serviceRequests/{requestId} {
      // Anyone can submit a booking request
      allow create: if true;

      // Admins can read all; Customers can read their own bookings; Public can read for tracking
      allow read: if true;

      // Only Admins can update status, assign technicians, or delete
      allow update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 2. USER PROFILES, MY ACCOUNT & CUSTOMER HISTORY
    // ==========================================
    match /users/{userId} {
      // User can view & manage their own profile; Admin has full access
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();

      // Permanent lifetime user request and order subcollections
      match /requests/{subRequestId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      match /orders/{subOrderId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }

      match /history/{historyId} {
        allow read, write: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }

    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // 3. INVOICES, BILLING & PAYMENT RECEIPTS
    // ==========================================
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.customerEmail.lower() == request.auth.token.email.lower()
        )
      );
      allow write: if isAdmin();
    }

    match /billing/{billId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.customerEmail.lower() == request.auth.token.email.lower()
        )
      );
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          resource.data.customerEmail.lower() == request.auth.token.email.lower()
        )
      );
      allow write: if isAdmin();
    }

    // ==========================================
    // 4. TECHNICIANS & LIVE GPS RIDE TRACKING
    // ==========================================
    match /technicians/{techId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /rides/{rideId} {
      // Public / Customer can track active live ride by ID
      allow read: if true;
      allow write: if isAdmin();
    }

    match /liveLocations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 5. DAILY WORK GALLERY (Photos & Videos)
    // ==========================================
    match /galleryItems/{itemId} {
      allow read: if isAdmin() || resource.data.isPublished == true || !('isPublished' in resource.data);
      allow write: if isAdmin();
    }

    match /gallery/{itemId} {
      allow read: if isAdmin() || resource.data.isPublished == true || !('isPublished' in resource.data);
      allow write: if isAdmin();
    }

    // ==========================================
    // 6. SERVICES CATALOG
    // ==========================================
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 7. HERO SLIDES & HOMEPAGE SECTIONS
    // ==========================================
    match /heroSlides/{slideId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /homepageSections/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 8. BLOG POSTS, VIEWS & NEWSLETTER
    // ==========================================
    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogPostViews/{slug} {
      allow read: if true;
      allow create, update: if true; // Public can increment view count
      allow delete: if isAdmin();
    }

    match /newsletterSubscribers/{subId} {
      allow create: if true; // Public can subscribe with email
      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // 9. FAQS & TESTIMONIALS
    // ==========================================
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if true; // Customers can submit reviews
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 10. CONTACT MESSAGES & INQUIRIES
    // ==========================================
    match /contactMessages/{messageId} {
      allow create: if true; // Public can send inquiries
      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // 11. WEBSITE SETTINGS
    // ==========================================
    match /websiteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ==========================================
    // 12. PRIVATE ADMIN LOGS & NOTIFICATIONS
    // ==========================================
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read, write: if isAdmin();
    }

    // ==========================================
    // 13. DEFAULT CATCH-ALL
    // ==========================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
