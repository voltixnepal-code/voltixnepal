// Prisma Schema for VoltixNepal

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String           @id @default(cuid())
  firebaseUid  String?          @unique
  name         String
  email        String           @unique
  phone        String?
  role         String           @default("CUSTOMER") // "CUSTOMER" or "ADMIN"
  isBlocked    Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  requests     ServiceRequest[]
}

model ServiceRequest {
  id               String   @id @default(cuid())
  requestId        String   @unique // e.g. "VN-2026-000001"
  userId           String?
  user             User?    @relation(fields: [userId], references: [id])
  customerName     String
  customerPhone    String
  customerEmail    String?
  preferredContact String   @default("WHATSAPP") // "WHATSAPP", "PHONE", "EMAIL"
  serviceId        String?
  serviceName      String
  urgency          String   @default("NORMAL") // "NORMAL", "URGENT", "EMERGENCY"
  preferredDate    String?
  preferredTime    String?
  description      String
  address          String
  area             String?
  city             String   @default("Kathmandu")
  latitude         Float?
  longitude        Float?
  googleMapsUrl    String?
  additionalNotes  String?
  status           String   @default("NEW") // "NEW", "CONTACTED", "CONFIRMED", "IN_PROGRESS", "COMPLETED", "CANCELLED"
  internalNotes    String?
  adminAssigned    String?

  // Financial & Billing Tracking
  billedAmount     Float?   @default(0)
  paidAmount       Float?   @default(0)
  paymentStatus    String   @default("UNPAID") // "UNPAID", "PAID", "PARTIAL"
  paymentMethod    String?  @default("CASH")   // "CASH", "ESEWA", "KHALTI", "BANK_TRANSFER", "FONEPAY"
  paymentNotes     String?
  paidAt           DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Service {
  id               String   @id @default(cuid())
  slug             String   @unique
  title            String
  shortDescription String
  fullDescription  String
  category         String   @default("Residential") // "Residential", "Commercial", "Emergency", "Installation"
  priceDisplay     String?  // e.g. "Inspection from Rs. 500" or "Custom Quote"
  imageUrl         String
  iconName         String   @default("Wrench")
  benefits         String   // JSON string of string array
  includedItems    String   // JSON string of string array
  whenNeeded       String   // JSON string of string array
  serviceArea      String   @default("Kathmandu, Lalitpur, Bhaktapur & surrounding areas")
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model HeroSlide {
  id               String   @id @default(cuid())
  badge            String   @default("PROFESSIONAL ELECTRICAL SERVICES")
  title            String
  description      String
  primaryBtnText   String   @default("Request a Service")
  primaryBtnLink   String   @default("/request-service")
  secondaryBtnText String?  @default("Call Now")
  secondaryBtnLink String?  @default("tel:+9779800000000")
  imageUrl         String
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Testimonial {
  id           String   @id @default(cuid())
  customerName String
  location     String   @default("Kathmandu")
  rating       Int      @default(5)
  content      String
  date         String
  photoUrl     String?
  isApproved   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BlogPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  content         String
  summary         String
  featuredImage   String
  category        String   @default("Electrical Safety")
  tags            String   @default("wiring,safety,home")
  author          String   @default("Sanjit Mishra")
  seoTitle        String?
  metaDescription String?
  isPublished     Boolean  @default(true)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteSettings {
  id                 String   @id @default("default_settings")
  businessName       String   @default("VoltixNepal")
  ownerName          String   @default("Sanjit Mishra")
  tagline            String   @default("Professional Electrical Services in Nepal")
  phone              String   @default("+977 9800000000")
  whatsappNumber     String   @default("9779800000000")
  email              String   @default("sanjit@voltixnepal.com")
  address            String   @default("Kathmandu, Bagmati Province, Nepal")
  businessHours      String   @default("Sunday - Friday: 7:00 AM - 8:00 PM | Saturday: Emergency Only")
  emergencyAvailable Boolean  @default(true)
  emergencyPhone     String   @default("+977 9800000000")
  googleMapsUrl      String   @default("https://maps.google.com/?q=Kathmandu,Nepal")
  footerText         String   @default("Reliable, safety-certified electrical installations, maintenance, and emergency repair services across Kathmandu Valley.")
  announcementText   String?  @default("24/7 Emergency Electrical Breakdown Service Active in Kathmandu Valley")
  announcementActive Boolean  @default(true)
  facebookUrl        String?  @default("https://facebook.com")
  instagramUrl       String?  @default("https://instagram.com")
  tiktokUrl          String?  @default("https://tiktok.com")
  youtubeUrl         String?  @default("https://youtube.com")

  // About Us CMS Fields
  aboutTitle           String?  @default("Reliable Electrical Workmanship with Safety at the Core")
  aboutSubtitle        String?  @default("Standardized safety, transparent diagnostics, and punctual technician dispatch across Kathmandu Valley.")
  aboutStory           String?  @default("VoltixNepal was founded by Sanjit Mishra to address a persistent issue in Kathmandu Valley electrical contracting: the lack of standardized safety, transparent diagnostics, and punctual technician dispatch.")
  aboutMission         String?  @default("Protecting lives, eliminating electrical fire hazards, and ensuring electrical installations function safely without voltage fluctuations or insulation failure.")
  aboutVision          String?  @default("To be Nepal's most trusted and technologically advanced electrical contracting and safety engineering team.")
  aboutOwnerTitle      String?  @default("Lead Electrician & Proprietor")
  aboutOwnerBio        String?  @default("Certified lead electrician with over 10 years of extensive experience delivering residential wiring, commercial automation, and rapid emergency troubleshooting.")
  aboutOwnerPhoto      String?  @default("https://images.unsplash.com/photo-1621905251189-08b45d6a269e?auto=format&fit=crop&w=1200&q=80")
  aboutCoverPhoto      String?  @default("https://images.unsplash.com/photo-1581092335397-9583fe92d232?auto=format&fit=crop&w=1200&q=80")
  aboutExperienceYears Int?     @default(10)
  aboutProjectsDone    Int?     @default(1500)
  aboutHappyClients    Int?     @default(1200)

  // Homepage About Snippet Fields
  aboutHeadline    String?  @default("Experienced Hands-On Electrical Contractor in Kathmandu")
  aboutBio1        String?  @default("Hello, I am {ownerName}, the founder and chief electrician at VoltixNepal. I specialize in providing dependable, safe, and modern electrical services for residential apartments, independent homes, and commercial offices across Kathmandu Valley.")
  aboutBio2        String?  @default("Whether you are rewiring a building, diagnosing a recurring circuit breaker trip, installing an inverter backup, or dealing with an unexpected power short circuit, I ensure meticulous attention to detail and zero compromises on safety standards.")
  aboutHighlights  String?  @default("[\"House Wiring & Concealed Piping\",\"Short Circuit Diagnostic & Megger Test\",\"Inverter & Battery Wiring\",\"Distribution Board Balancing\"]")
  aboutBookBtnText String?  @default("Book a Service with Sanjit")

  updatedAt          DateTime @updatedAt
}

model HomepageSection {
  id         String   @id @default(cuid())
  sectionKey String   @unique // "hero", "emergency_banner", "services", "why_choose_us", "about", "testimonials", "faq", "blog", "cta"
  label      String
  isEnabled  Boolean  @default(true)
  sortOrder  Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  type      String   @default("SERVICE_REQUEST") // "SERVICE_REQUEST", "CUSTOMER_SIGNUP", "SYSTEM"
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String   // e.g. "UPDATE_REQUEST_STATUS", "EDIT_SERVICE", "UPDATE_SETTINGS"
  entityType String   // "ServiceRequest", "Service", "Settings", etc.
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}

model GalleryItem {
  id              String   @id @default(cuid())
  title           String
  description     String?
  mediaType       String   @default("PHOTO") // "PHOTO" or "VIDEO"
  storageProvider String   @default("CLOUDINARY") // "CLOUDINARY" or "CLOUDFLARE_R2"
  mediaUrl        String
  thumbnailUrl    String?
  fileSizeBytes   Int?
  category        String   @default("House Wiring") // "House Wiring", "Emergency Repair", "Inverter & Battery", "Distribution Board", "Lighting & Fixtures", "Earthing Pit", "Commercial"
  location        String?  @default("Kathmandu")
  dateTaken       DateTime @default(now())
  isPublished     Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
