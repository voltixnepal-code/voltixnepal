# ==========================================
# VoltixNepal Environment Configuration
# ==========================================

# Database Connection (Supabase / PostgreSQL or local SQLite)
# For local SQLite: "file:./dev.db"
# For PostgreSQL / Supabase: "postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public"
DATABASE_URL="file:./dev.db"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase Client Configuration (Spark Free Plan)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin SDK (Server-side token verification)
# (Paste private key JSON string or provide project credentials)
FIREBASE_ADMIN_PROJECT_ID=""
FIREBASE_ADMIN_CLIENT_EMAIL=""
FIREBASE_ADMIN_PRIVATE_KEY=""

# Admin Configuration & Secret Token (For admin verification & initial setup)
ADMIN_EMAIL="sanjeet@voltixnepal.com"
ADMIN_INITIAL_PIN="Voltix2026Admin!"
ADMIN_SECRET_KEY="voltix-secret-admin-token-super-secure-key"

# SMTP Email Configuration (Nodemailer - Server-side only, NEVER in frontend)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@voltixnepal.com"
SMTP_PASSWORD="your-app-password-here"
SMTP_FROM="VoltixNepal Service <notifications@voltixnepal.com>"

# WhatsApp Business Dispatch
# Format: CountryCode + Number (e.g. 9779800000000)
WHATSAPP_BUSINESS_NUMBER="9779800000000"

# Google Maps API (Optional, website uses standard browser geolocation + universal Google Maps links)
GOOGLE_MAPS_API_KEY=""

# Google Gemini API Key (Server-side)
GEMINI_API_KEY=""

# Cloudinary Configuration (Photos & Image CMS < 100MB)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Cloudflare R2 Storage (HD Videos < 500MB, 10GB Free Tier)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="voltixnepal-videos"
R2_PUBLIC_DOMAIN="https://videos.voltixnepal.com"

